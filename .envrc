# Check if uv is installed
if ! command -v uv &> /dev/null; then
  echo "Error: uv is not installed. Please install uv first."
  echo "https://github.com/astral-sh/uv?tab=readme-ov-file#installation"
  exit 1
fi

if test -f .envrc.local; then
  source .envrc.local
else
  echo ".envrc.local not found. Check the README for instructions."
fi

export OUTPUT_DIR='images' # the directory images will be saved to

# re-run this .envrc (and re-sync) whenever dependencies change
watch_file pyproject.toml uv.lock

echo ""
echo "Syncing / Installing packages and activating the virtual environment"
uv sync

# Let direnv own the venv activation so PATH is cleanly reverted on exit.
export VIRTUAL_ENV="${PWD}/.venv"
PATH_add "${PWD}/.venv/bin"

# create the output directory
if [ ! -d "$OUTPUT_DIR" ] ; then
  echo "Creating the ${OUTPUT_DIR} directory"
  mkdir "$OUTPUT_DIR"
fi

GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# announce python version and show the path of the current python in ${PATH}
echo ""
echo -e "Virtualenv has been activated for ${GREEN}$(python3 -V)${NC}"
echo -e "Using venv folder: ${CYAN}$(which python3)${NC}\\n"
